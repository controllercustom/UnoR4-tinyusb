//
// Uno R4 Minima / Nano R4 (this repo):
//   Console is Serial1 (FTDI bridge on RX1/TX1) @ 115200 — the R4's own USB
//   connector is the RUSB2 port TinyUSB owns, so there is no USB console.
//   VBUS: the board does NOT source 5 V from its USB connector. Self-powered
//   (and full-/low-speed) devices work direct; bus-powered ones need
//   backpowering or a powered hub.
//   Configuration: this sketch ships a lean single-role config. Activate it
//   with `./scripts/config.sh set Device_msc_dual_lun` (required before building any other
//   example — a device-role config sets CFG_TUH_ENABLED 0, and vice versa).
// Device_msc_dual_lun.ino — USB Mass Storage with 2 LUNs (device mode).
//
// Ported from TinyUSB examples/device/msc_dual_lun. Each LUN is a 12-sector
// x 512B = 6KB FAT12 RAM disk (README0.TXT / README1.TXT), so total static
// RAM stays at ~16KB. Both LUNs appear as removable drives on the PC.
//
// Works on ALL boards (UnoR4TinyUSB multi-board library).
// Debug: UNOR4_TINYUSB_CONSOLE @ UNOR4_TINYUSB_BAUD.
//
// Adaptations:
// - Descriptors + MSC callbacks in the usb_descriptors.cpp tab (the .ino
//   prototype generator mangles extern "C").
// - MSC bulk endpoints use distinct physical EP numbers (OUT 0x01, IN 0x82):
//   the SAM3X DEVEPTCFG EPDIR bit is write-once in silicon, so the bulk OUT
//   and IN must live on distinct physical endpoints.
// - tud_msc_test_unit_ready_cb() always returns true (upstream uses the
//   board button to simulate LUN1 medium-removed; there is no such button).
// - LED blink via LED_BUILTIN + millis().

#include <UnoR4TinyUSB.h>
#include <string.h>

#define USB_VID 0xCafe
#define USB_PID 0x4016

enum
{
  BLINK_NOT_MOUNTED = 250,
  BLINK_MOUNTED = 1000,
  BLINK_SUSPENDED = 2500
};

uint32_t blinkIntervalMs = BLINK_NOT_MOUNTED;

#if defined(CFG_EXAMPLE_MSC_READONLY) || defined(CFG_EXAMPLE_MSC_DUAL_READONLY)
  #define MSC_CONST const
#else
  #define MSC_CONST
#endif

enum {
  // 12 sectors x 512B = 6KB per LUN. Upstream uses 16 (8KB, the smallest
  // Windows mounts); 12 keeps both LUNs inside small-SRAM boards alongside
  // the multi-class config. Boot-sector total-sectors fields below match.
  DISK_BLOCK_NUM  = 12,
  DISK_BLOCK_SIZE = 512
};

